#!/usr/bin/env sh
# Engineering Constitution pre-commit hook
# Enforces: LAW-6.2 (Quality Gates Are Inviolable), LAW-2.2 (Prettier),
#           Article 2 lint rules, LAW-2.3/2.4 via type-check.
# Installed into .husky/pre-commit by scripts/install.sh.

set -e

echo "constitution: pre-commit gates (LAW-6.2) — lint-staged, then type-check"

npx lint-staged || {
  echo ""
  echo "✗ Lint/format gate failed."
  echo "  [LAW-2.2 v1.0] Formatting is never manual — run: npx prettier --write ."
  echo "  Article 2 lint errors must be fixed, not suppressed (LAW-1.3: no local exceptions)."
  exit 1
}

npm run type-check || {
  echo ""
  echo "✗ Type-check gate failed."
  echo "  [LAW-2.3 v1.0] The \`any\` type is prohibited — use \`unknown\` with narrowing."
  echo "  [LAW-2.4 v1.0] Exported functions declare explicit return types."
  echo "  Fix the types; do not weaken tsconfig (LAW-6.2: gates have no override path)."
  exit 1
}

echo "✓ Pre-commit gates green."
