    "smoke": "node dist/server.js --self-test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.20.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jest": "29.5.13",
    "@types/node": "20.16.10",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.1",
    "typescript": "5.1.6"
  }
}
